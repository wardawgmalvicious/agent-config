# ==============================================================
# Root-anchored runtime-state guards. These date from the era when
# this repo WAS ~/.claude and Claude Code wrote runtime state into
# the working tree; they're kept in case the repo is ever cloned
# there again. Anchored to the repo root (leading /) so same-named
# directories under per-tool payload dirs are NOT swallowed: a
# pattern with no slash before its trailing one (`sessions/`,
# `cache/`) matches at ANY depth — e.g. `sessions/` would silently
# ignore a committed <tool>/sessions/. (Patterns with a middle slash,
# like `prompts/*`, were already anchored to this directory; the
# leading / just makes the anchoring uniform and explicit.)
# ==============================================================

# Nested project-scope .claude/ that Claude Code creates when
# launched inside this directory. settings.json is this repo's own
# shared project config and IS tracked; settings.local.json (personal
# permissions) stays ignored by the name-based rule further down.
/.claude/*
!/.claude/settings.json

# Personal Claude Desktop project instructions — not portable, may
# contain sensitive information.
/docs/project-instructions/*

# docs/audits/ is deliberately NOT ignored — see docs/audits/README.md.
# It carried /docs/audits/* until 2026-09-07 on the rationale that the
# output was regenerable. That was disproven the same day: the powerbi
# source 404'd at every endpoint, so the run already on disk could no
# longer be re-fetched. Audit output is now tracked, which is also what
# makes the audit -> handoff -> update pipeline portable across machines.

# Runtime prompt/log/memory state.
/prompts/*
/logs/*
/agent-memory/*
/agent-memory-local/*

# Claude Code runtime state — not portable, not backup-worthy.
/cache/
/backups/
/file-history/
/shell-snapshots/
/sessions/
/session-env/
/projects/
/todos/
/statsig/
/telemetry/
/ide/
/debug/
/downloads/
/plugins/
/.last-cleanup
/history.jsonl
/mcp-needs-auth-cache.json
/stats-cache.json

# ==============================================================
# Secrets and local-only overrides — never commit, at any depth
# (deliberately unanchored: these are name-based safety nets).
# ==============================================================
.credentials.json
settings.local.json
*.key
*.pem
.env
*_credentials.json
*credentials*.json

# ==============================================================
# OS / editor noise
# ==============================================================
.DS_Store
Thumbs.db
desktop.ini
# .vscode is ignored except the files this repo deliberately shares:
# the committed workspace MCP config, the VS Code / Copilot MCP template
# this repo publishes, their README, and the workspace editor config
# (settings, tasks, extension recommendations). settings.local.json is
# still caught by the name-based rule above, at any depth.
/.vscode/*
!/.vscode/mcp.json
!/.vscode/mcp.template.json
!/.vscode/README.md
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/extensions.json
.idea/
*.swp
*~
