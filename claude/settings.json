{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/log-instructions-loaded.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/security-reviewer-memory-scope.sh"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/identity-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/log-skill-invocations.sh"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/identity-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/prune-probe-sessions.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/offer-handoff.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/name-session.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "cowork-plugin-management@synced": false
  },
  "skillOverrides": {
    "anthropic-skills:personal-init": "off",
    "anthropic-skills:project-init": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:docx": "user-invocable-only",
    "anthropic-skills:pptx": "user-invocable-only",
    "anthropic-skills:xlsx": "user-invocable-only",
    "anthropic-skills:pdf": "user-invocable-only"
  },
  "extraKnownMarketplaces": {},
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "bashOutputMaxChars": 128000,
  "cleanupPeriodDays": 15,
  "autoUpdatesChannel": "latest",
  "permissions": {
    "defaultMode": "auto"
  },
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "true"
  },
  "deniedMcpServers": [
    { "serverName": "claude.ai Claude Docs" }
  ]
}
