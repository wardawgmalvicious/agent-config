{
    "mcpServers": {
        "github-mcp": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer ${<GITHUB_PAT_VAR>}"
            }
        },
        "fabric-sqlendpoint": {
            "type": "http",
            "url": "https://api.fabric.microsoft.com/v1/mcp/dataPlane/sqlEndpoint",
            "headersHelper": "az account get-access-token --resource https://api.fabric.microsoft.com --query \"{Authorization: join(' ', ['Bearer', accessToken])}\" --output json --only-show-errors"
        },
        "fabric-kqlendpoint": {
            "type": "http",
            "url": "https://api.fabric.microsoft.com/v1/mcp/dataPlane/kqlEndpoint",
            "headersHelper": "az account get-access-token --resource https://api.fabric.microsoft.com --query \"{Authorization: join(' ', ['Bearer', accessToken])}\" --output json --only-show-errors"
        },
        "powerbi-remote-mcp": {
            "type": "http",
            "url": "https://api.fabric.microsoft.com/v1/mcp/powerbi",
            "headersHelper": "az account get-access-token --resource https://api.fabric.microsoft.com --query \"{Authorization: join(' ', ['Bearer', accessToken])}\" --output json --only-show-errors"
        },
        "activator-remote-mcp": {
            "type": "http",
            "url": "https://api.fabric.microsoft.com/v1/mcp/workspaces/<WorkspaceId>/reflexes/<ActivatorId>",
            "headersHelper": "az account get-access-token --resource https://api.fabric.microsoft.com --query \"{Authorization: join(' ', ['Bearer', accessToken])}\" --output json --only-show-errors"
        },
        "powerbi-modeling-mcp": {
            "type": "stdio",
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "@microsoft/powerbi-modeling-mcp@latest",
                "--start"
            ]
        },
        "microsoft-fabric-mcp": {
            "type": "stdio",
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "@microsoft/fabric-mcp@latest",
                "server",
                "start",
                "--mode",
                "all"
            ]
        },
        "fabric-rti-mcp": {
            "type": "stdio",
            "command": "uvx",
            "args": [
                "microsoft-fabric-rti-mcp"
            ]
        },
        "fabric-data-factory-mcp": {
            "type": "stdio",
            "command": "dnx",
            "args": [
                "Microsoft.DataFactory.MCP",
                "--prerelease",
                "--yes"
            ]
        },
        "sql-mcp": {
            "type": "stdio",
            "command": "dab",
            "args": [
                "start",
                "--mcp-stdio",
                "--config",
                "<ABSOLUTE_PATH_TO_REPO>/api/dab-config.json",
                "--LogLevel",
                "Error"
            ],
            "env": {
                "DAB_CONNECTION_STRING": "Server=tcp:<your-sql-server>.database.windows.net,1433;Initial Catalog=<your-database>;Encrypt=True;TrustServerCertificate=False;Authentication=Active Directory Interactive;Connection Timeout=60;",
                "ASPNETCORE_URLS": "http://127.0.0.1:0"
            }
        },
        "azure-devops-mcp": {
            "type": "stdio",
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "@azure-devops/mcp@latest",
                "<OrgName>",
                "<ProjectName>"
            ]
        }
    }
}
