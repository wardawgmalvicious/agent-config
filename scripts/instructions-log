#!/bin/bash
# instructions-log — query the hook observability logs.
#
# The InstructionsLoaded hook fires whenever a CLAUDE.md or .claude/rules/*.md
# file is loaded into context; a PostToolUse hook on the Skill tool logs every
# skill invocation. Both write pure JSONL (one JSON object per line, with a
# `ts` timestamp field). This script provides convenience queries over those
# logs for diagnosing what loaded, when, and why.
#
# Usage:
#   instructions-log today      Today's instruction loads, pretty-printed JSON
#   instructions-log reasons    Count instruction loads by load_reason
#   instructions-log paths      Files loaded via path_glob_match
#   instructions-log csv        Dump the instruction log as CSV (stdout)
#   instructions-log skills     Count skill invocations by skill name
#   instructions-log tail       Follow the instruction log live (Ctrl-C stops)
#   instructions-log            Print this usage message
#
# Requires: jq (https://jqlang.org). Install on Windows via:
#     curl -L -o /mingw64/bin/jq.exe \
#       https://github.com/jqlang/jq/releases/latest/download/jq-windows-amd64.exe
#
# Log locations: ~/.claude/logs/instructions-loaded.log
#                ~/.claude/logs/skills-invoked.log
# Hook config:   ~/.claude/settings.json (InstructionsLoaded + PostToolUse)
# Hook scripts:  ~/.claude/hooks/log-instructions-loaded.sh
#                ~/.claude/hooks/log-skill-invocations.sh

set -euo pipefail

LOG="$HOME/.claude/logs/instructions-loaded.log"
SKILLS_LOG="$HOME/.claude/logs/skills-invoked.log"

usage() {
  sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

require_log() {
  if [[ ! -f "$1" ]]; then
    echo "Log not found: $1" >&2
    echo "Check that the hooks are configured in ~/.claude/settings.json" >&2
    exit 1
  fi
}

require_jq() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "jq not installed. See script header for install instructions." >&2
    exit 1
  fi
}

# Stream a log as one JSON object per line, silently dropping any line that
# will not parse.
#
# The hook appends with `>>`, and MSYS on Windows does not make that write
# atomic, so two hook invocations firing at the same instant can tear a
# record: one line ends up holding a truncated object spliced into a whole
# one. It is rare (1 line in 1703 on 2026-09-01) and unrecoverable after the
# fact — but a single bad line makes a whole-file `jq` abort with
# "Invalid escape ..." and, under `set -o pipefail`, takes the entire query
# down with it. That failure reads like a broken script rather than one bad
# line, which is exactly how it was mis-diagnosed. Reading line-at-a-time
# with `fromjson?` confines the damage to the torn record.
valid_lines() {
  jq -R -c 'fromjson? // empty' "$1"
}

case "${1:-}" in
  today)
    require_log "$LOG"
    require_jq
    valid_lines "$LOG" | grep "\"ts\":\"$(date -I)" | jq .
    ;;
  reasons)
    require_log "$LOG"
    require_jq
    valid_lines "$LOG" | jq -r .load_reason | sort | uniq -c | sort -rn
    ;;
  paths)
    require_log "$LOG"
    require_jq
    valid_lines "$LOG" | grep 'path_glob_match' | jq -r .file_path | sort | uniq -c | sort -rn
    ;;
  csv)
    require_log "$LOG"
    require_jq
    echo 'ts,load_reason,memory_type,file_path,cwd,session_id'
    valid_lines "$LOG" | jq -r '[.ts, .load_reason, .memory_type, .file_path, .cwd, .session_id] | @csv'
    ;;
  skills)
    require_log "$SKILLS_LOG"
    require_jq
    valid_lines "$SKILLS_LOG" | jq -r .skill | sort | uniq -c | sort -rn
    ;;
  tail)
    require_log "$LOG"
    require_jq
    tail -f "$LOG" | while IFS= read -r line; do
      echo "$line" | jq . 2>/dev/null || echo "$line"
    done
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "Unknown subcommand: $1" >&2
    echo "" >&2
    usage >&2
    exit 1
    ;;
esac
